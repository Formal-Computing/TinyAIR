-- Dafny A/B example with genuine lexicographic decreases tuples.
-- A(x) -> B(x): (x,0) < (x,1)
-- B(x) -> A(x-1): (x-1,1) < (x,0), when x>0

A :: Int -> Int
requires x >= 0
decreases x, 1
ensures result == 0
A x = B(x)

B :: Int -> Int
requires x >= 0
decreases x, 0
ensures result == 0
B x = if x != 0 then A(x - 1) else 0
